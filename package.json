{
  "name": "clip-cli",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "site:dev": "node scripts/serve-site.mjs",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node --check site/main.js && node --check site/theme.js && node --test scripts/*.test.mjs",
    "package:check": "node scripts/check-packages.mjs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check": "pnpm --filter cliplink typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "pnpm": {
    "overrides": {
      "cliplink-schema": "workspace:*"
    }
  }
}
