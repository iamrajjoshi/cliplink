{
  "name": "clip-cli",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "check": "pnpm --filter cliplink typecheck",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip --include dependencies,devDependencies,unlisted,binaries"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.2.1",
    "globals": "^17.5.0",
    "knip": "^6.32.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  },
  "pnpm": {
    "overrides": {
      "cliplink-schema": "workspace:*"
    }
  }
}
