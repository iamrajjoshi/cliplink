{
  "name": "cliplink",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/iamrajjoshi/cliplink.git"
  },
  "type": "module",
  "description": "Save links, images, and notes as Markdown in your own GitHub repository",
  "homepage": "https://cliplink.dev/",
  "bin": {
    "clip": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clip": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "cliplink-schema": "^0.1.0",
    "@inquirer/prompts": "^8.4.2",
    "node-html-parser": "^7.1.0",
    "sharp": "^0.34.5",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.21.0"
  }
}
