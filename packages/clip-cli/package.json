{
  "name": "cliplink",
  "version": "0.2.1",
  "license": "MIT",
  "author": "Raj Joshi (https://rajjoshi.me/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamrajjoshi/cliplink.git",
    "directory": "packages/clip-cli"
  },
  "bugs": {
    "url": "https://github.com/iamrajjoshi/cliplink/issues"
  },
  "keywords": [
    "cli",
    "bookmarks",
    "markdown",
    "github",
    "clips",
    "rss"
  ],
  "type": "module",
  "description": "Save links, images, and notes as Markdown in your own GitHub repository",
  "homepage": "https://cliplink.dev/",
  "bin": {
    "clip": "dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clip": "tsx src/index.ts",
    "build": "tsup",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "test": "tsx --test src/__tests__/*.test.ts"
  },
  "dependencies": {
    "cliplink-schema": "^0.1.2",
    "@inquirer/prompts": "^8.7.1",
    "node-html-parser": "^7.1.0",
    "sharp": "^0.35.4",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.23.13"
  }
}
